function saveTariff(clientId){
  const c = clients.find(x=>x.id===clientId);
  const liters = Math.max(0, parseFloat(document.getElementById('tariffLiters-'+clientId).value) || 0);
  const price = Math.max(0, parseFloat(document.getElementById('tariffPrice-'+clientId).value) || 0);
  c.storageLiters = liters;
  c.pricePerLiter = price;
  c.storageHistory = generateStorageHistory(c);
  toast('Тариф хранения сохранён');
  renderClients();
  sb.from('clients').update({storage_liters: liters, price_per_liter: price}).eq('id', clientId).then(({error})=>{
    if(error){ console.error(error); toast('Не удалось сохранить тариф в базе'); }
  });
}
function generateStorageHistory(client, days){
  days = days || 30;
  const history = [];
  let liters = client.storageLiters>0 ? client.storageLiters * (0.7 + Math.random()*0.3) : 0;
  for(let i=days-1; i>=0; i--){
    if(client.storageLiters>0){
      liters += (Math.random()-0.45) * client.storageLiters * 0.06;
      liters = Math.max(client.storageLiters*0.4, liters);
    }
    const date = new Date();
    date.setDate(date.getDate()-i);
    history.push({date, liters: Math.round(liters), cost: liters * client.pricePerLiter / 30});
  }
  if(history.length){
    history[history.length-1].liters = client.storageLiters;
    history[history.length-1].cost = client.storageLiters * client.pricePerLiter / 30;
  }
  return history;
}

