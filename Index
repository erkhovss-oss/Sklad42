<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>СКЛАД/42 — прототип</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#F0EEE6;
    --panel:#FFFFFF;
    --ink:#1C1B19;
    --ink-soft:#6B665C;
    --ink-faint:#A39C8C;
    --accent:#FF5B1F;
    --accent-ink:#FFFFFF;
    --ok:#2F7D4F;
    --ok-bg:#E7F2EA;
    --warn:#B5471B;
    --warn-bg:#FBE9E1;
    --line:#DCD6C6;
    --wb:#7A1FA8;
    --wb-bg:#F1E4F7;
    --oz:#005BFF;
    --oz-bg:#E3ECFF;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .mono{font-family:'IBM Plex Mono',monospace;}
  .eyebrow{
    font-family:'Barlow Condensed',sans-serif;
    text-transform:uppercase;
    letter-spacing:0.08em;
    font-weight:600;
    color:var(--ink-soft);
    font-size:12px;
  }
  h1,h2,h3{
    font-family:'Barlow Condensed',sans-serif;
    text-transform:uppercase;
    letter-spacing:0.01em;
    margin:0;
    font-weight:700;
  }

  .app{display:flex;min-height:100vh;}

  /* Sidebar */
  .sidebar{
    width:212px;
    flex-shrink:0;
    background:var(--ink);
    color:#EDE9DD;
    display:flex;
    flex-direction:column;
    padding:20px 14px;
  }
  .logo{
    display:flex;
    align-items:baseline;
    gap:6px;
    padding:6px 10px 22px 10px;
  }
  .logo b{
    font-family:'Barlow Condensed',sans-serif;
    font-size:22px;
    font-weight:700;
    letter-spacing:0.02em;
  }
  .logo span{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    color:var(--accent);
  }
  .nav-group-label{
    font-family:'IBM Plex Mono',monospace;
    font-size:10px;
    text-transform:uppercase;
    letter-spacing:0.1em;
    color:#68625A;
    padding:8px 12px 4px 12px;
  }
  .nav-item{
    display:flex;
    align-items:center;
    gap:10px;
    padding:11px 12px;
    border-radius:8px;
    font-family:'Barlow Condensed',sans-serif;
    font-size:16px;
    font-weight:600;
    letter-spacing:0.02em;
    text-transform:uppercase;
    color:#C9C3B4;
    cursor:pointer;
    border:1px solid transparent;
    position:relative;
  }
  .nav-item .num{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    color:#68625A;
    width:16px;
    text-transform:none;
  }
  .nav-item:hover{color:#fff;}
  .nav-item.active{
    background:#28251F;
    color:#fff;
    border-color:#3A362D;
  }
  .nav-item.active .num{color:var(--accent);}
  .nav-item .badge{
    margin-left:auto;
    background:var(--accent);
    color:#fff;
    font-family:'IBM Plex Mono',monospace;
    font-size:10px;
    padding:1px 6px;
    border-radius:20px;
  }
  .sidebar-foot{
    margin-top:auto;
    padding:10px;
    font-size:11px;
    color:#68625A;
    font-family:'IBM Plex Mono',monospace;
    border-top:1px solid #2C2922;
    padding-top:14px;
  }

  /* Main */
  .main{flex:1;min-width:0;display:flex;flex-direction:column;}
  .topbar{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:16px 28px;
    border-bottom:1px solid var(--line);
    background:var(--panel);
  }
  .cabinets{display:flex;gap:8px;}
  .chip{
    display:flex;
    align-items:center;
    gap:6px;
    padding:6px 12px;
    border-radius:20px;
    font-size:12px;
    font-weight:600;
  }
  .chip .dot{width:6px;height:6px;border-radius:50%;background:var(--ok);}
  .chip.wb{background:var(--wb-bg);color:var(--wb);}
  .chip.oz{background:var(--oz-bg);color:var(--oz);}

  .content{padding:26px 28px 60px 28px;flex:1;}
  .section{display:none;}
  .section.active{display:block;}

  .page-head{
    display:flex;
    align-items:flex-end;
    justify-content:space-between;
    margin-bottom:20px;
  }
  .page-head h1{font-size:30px;}
  .page-head p{margin:4px 0 0 0;color:var(--ink-soft);font-size:14px;}

  .btn{
    font-family:'Inter',sans-serif;
    font-weight:600;
    font-size:13px;
    border:none;
    border-radius:8px;
    padding:10px 16px;
    cursor:pointer;
    display:inline-flex;
    align-items:center;
    gap:6px;
  }
  .btn-primary{background:var(--ink);color:#fff;}
  .btn-primary:hover{background:#333029;}
  .btn-accent{background:var(--accent);color:#fff;}
  .btn-accent:hover{background:#E24E14;}
  .btn-ghost{background:transparent;color:var(--ink-soft);border:1px solid var(--line);}
  .btn-ghost:hover{border-color:var(--ink-soft);color:var(--ink);}
  .btn:disabled{opacity:0.4;cursor:not-allowed;}

  .stat-row{display:flex;gap:14px;margin-bottom:22px;}
  .stat{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:12px;
    padding:14px 18px;
    flex:1;
  }
  .stat .val{font-family:'Barlow Condensed',sans-serif;font-size:28px;font-weight:700;}
  .stat .lbl{font-size:12px;color:var(--ink-soft);margin-top:2px;}

  .panel{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:14px;
    overflow:hidden;
  }

  .barcode-rule{
    height:14px;
    background-image:repeating-linear-gradient(90deg, var(--ink) 0px, var(--ink) 1px, transparent 1px, transparent 3px, var(--ink) 3px, var(--ink) 5px, transparent 5px, transparent 8px);
    opacity:0.55;
    margin:20px 0;
    border-radius:2px;
  }

  table{width:100%;border-collapse:collapse;}
  th{
    text-align:left;
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:0.06em;
    color:var(--ink-faint);
    font-weight:600;
    padding:12px 18px;
    border-bottom:1px solid var(--line);
  }
  td{
    padding:13px 18px;
    border-bottom:1px solid var(--line);
    font-size:14px;
  }
  tr:last-child td{border-bottom:none;}
  .qty-low{color:var(--warn);font-weight:700;}
  .search{
    padding:9px 14px;
    border:1px solid var(--line);
    border-radius:8px;
    font-size:13px;
    width:260px;
    font-family:'Inter',sans-serif;
  }
  .search:focus{outline:2px solid var(--ink);outline-offset:1px;}

  .stepper-num{
    font-family:'IBM Plex Mono',monospace;
    font-size:11px;
    color:var(--accent);
    letter-spacing:0.05em;
  }

  .order-card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:12px;
    padding:16px 18px;
    margin-bottom:10px;
    display:flex;
    align-items:center;
    gap:16px;
    cursor:pointer;
  }
  .order-card:hover{border-color:var(--ink-soft);}
  .order-card .oid{font-family:'IBM Plex Mono',monospace;font-weight:600;font-size:14px;}
  .order-card .meta{color:var(--ink-soft);font-size:12px;margin-top:2px;}
  .status{
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:0.04em;
    padding:4px 10px;
    border-radius:20px;
    margin-left:auto;
  }
  .status.new{background:var(--oz-bg);color:var(--oz);}
  .status.assembling{background:#FBEFDD;color:#A06A00;}
  .status.assembled{background:var(--ok-bg);color:var(--ok);}
  .status.printed{background:#EFEAFB;color:#5B3FBF;}
  .status.overdue{background:var(--warn-bg);color:var(--warn);}
  .status.planned{background:var(--oz-bg);color:var(--oz);}
  .status.shipped{background:#EDEBE5;color:var(--ink-soft);}

  .empty{
    text-align:center;
    padding:60px 20px;
    color:var(--ink-faint);
  }
  .empty .eyebrow{display:block;margin-bottom:8px;}

  /* assembly */
  .assembly-layout{display:flex;gap:20px;align-items:flex-start;}
  .scan-box{
    background:var(--ink);
    border-radius:14px;
    padding:22px;
    width:340px;
    flex-shrink:0;
    color:#fff;
  }
  .scan-box .eyebrow{color:#9C9686;}
  .scan-input{
    width:100%;
    margin-top:12px;
    padding:13px 14px;
    border-radius:8px;
    border:2px solid #3A362D;
    background:#28251F;
    color:#fff;
    font-family:'IBM Plex Mono',monospace;
    font-size:15px;
  }
  .scan-input:focus{outline:none;border-color:var(--accent);}
  .scan-hint{font-size:11px;color:#8A8478;margin-top:8px;line-height:1.5;}
  .progress-track{height:6px;background:#3A362D;border-radius:4px;margin-top:18px;overflow:hidden;}
  .progress-fill{height:100%;background:var(--accent);transition:width .35s ease;}

  .pick-row{
    display:flex;
    align-items:center;
    gap:14px;
    padding:14px 18px;
    border-bottom:1px solid var(--line);
    position:relative;
    overflow:hidden;
  }
  .pick-row:last-child{border-bottom:none;}
  .pick-row .sku-name{font-weight:600;font-size:14px;}
  .pick-row .sku-code{font-size:12px;color:var(--ink-soft);}
  .pick-row .qty-need{margin-left:auto;font-family:'IBM Plex Mono',monospace;font-size:13px;color:var(--ink-soft);}
  .pick-row.done{background:var(--ok-bg);}
  .pick-row.done .sku-name{color:var(--ok);}
  .wb-thumb{
    width:44px;height:44px;flex-shrink:0;
    background:var(--bg);
    border:1px solid var(--line);
    border-radius:8px;
    display:flex;align-items:center;justify-content:center;
    font-size:18px;
    opacity:0.6;
  }
  .stamp{
    position:absolute;
    right:18px;
    top:50%;
    transform:translateY(-50%) rotate(-8deg);
    border:2px solid var(--ok);
    color:var(--ok);
    font-family:'Barlow Condensed',sans-serif;
    font-weight:700;
    font-size:12px;
    letter-spacing:0.08em;
    padding:2px 10px;
    border-radius:4px;
    opacity:0;
    animation:stamp-in .32s ease forwards;
  }
  @keyframes stamp-in{
    0%{opacity:0;transform:translateY(-50%) rotate(-8deg) scale(1.7);}
    100%{opacity:1;transform:translateY(-50%) rotate(-8deg) scale(1);}
  }

  /* print */
  .label-preview{
    width:340px;
    background:#fff;
    border:2px solid var(--ink);
    border-radius:6px;
    padding:18px;
    font-family:'IBM Plex Mono',monospace;
  }
  .label-preview .lp-top{display:flex;justify-content:space-between;font-size:11px;color:var(--ink-soft);}
  .label-preview .lp-oid{font-size:20px;font-weight:600;margin:10px 0 4px 0;}
  .label-preview .lp-bars{
    height:46px;
    margin:14px 0 8px 0;
    background-image:repeating-linear-gradient(90deg, var(--ink) 0px, var(--ink) 2px, transparent 2px, transparent 4px, var(--ink) 4px, var(--ink) 5px, transparent 5px, transparent 9px, var(--ink) 9px, var(--ink) 10px, transparent 10px, transparent 13px);
  }
  .lp-code{text-align:center;font-size:12px;letter-spacing:0.2em;}
  .lp-items{margin-top:14px;font-size:11px;color:var(--ink-soft);line-height:1.6;}

  .toast-wrap{
    position:fixed;
    bottom:20px;
    right:20px;
    display:flex;
    flex-direction:column;
    gap:8px;
    z-index:50;
  }
  .toast{
    background:var(--ink);
    color:#fff;
    padding:12px 16px;
    border-radius:10px;
    font-size:13px;
    display:flex;
    align-items:center;
    gap:10px;
    box-shadow:0 8px 20px rgba(0,0,0,0.18);
    animation:toast-in .25s ease;
    border-left:3px solid var(--accent);
  }
  @keyframes toast-in{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}

  .icon{width:17px;height:17px;flex-shrink:0;}

  #loginScreen{
    position:fixed; inset:0; z-index:100;
    background:var(--bg);
    display:flex; align-items:center; justify-content:center;
  }
  .login-card{
    width:340px;
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:16px;
    padding:32px;
    box-shadow:0 12px 32px rgba(0,0,0,0.08);
  }
  .sidebar-user{
    display:flex; flex-direction:column; gap:2px;
    padding:10px; margin-bottom:8px;
    background:#28251F; border-radius:8px;
  }
  .sidebar-user .name{font-size:13px;font-weight:600;color:#fff;}
  .sidebar-user .role{font-size:11px;color:#9C9686;}
</style>
</head>
<body>

<div id="loginScreen">
  <div class="login-card">
    <div class="logo" style="padding:0 0 22px 0"><b>СКЛАД/42</b><span>WMS</span></div>
    <div class="eyebrow" style="margin-bottom:16px">Вход в личный кабинет</div>
    <div class="eyebrow" style="margin-bottom:6px;color:var(--ink-soft)">Сотрудник</div>
    <select class="search" id="loginEmployeeSelect" style="width:100%;margin-bottom:14px"></select>
    <div class="eyebrow" style="margin-bottom:6px;color:var(--ink-soft)">PIN-код</div>
    <input class="search" id="loginPin" type="password" placeholder="••••" style="width:100%;margin-bottom:16px" maxlength="6">
    <button class="btn btn-accent" style="width:100%;justify-content:center" onclick="attemptLogin()">Войти</button>
    <p style="font-size:11px;color:var(--ink-faint);margin-top:14px;line-height:1.6">Демо-доступ: выберите сотрудника, PIN указан в разделе «Сотрудники» (по умолчанию у всех — 1234).</p>
  </div>
</div>

<div class="app" id="appRoot" style="display:none">
  <div class="sidebar">
    <div class="logo"><b>СКЛАД/42</b><span>WMS</span></div>
    <div class="nav-group-label">Склад</div>
    <div class="nav-item active" data-tab="inventory" style="padding-left:26px"><span class="num">01</span>Остатки</div>
    <div class="nav-item" data-tab="clients"><span class="num">02</span>Клиенты</div>
    <div class="nav-item" data-tab="storage"><span class="num">03</span>Хранение</div>
    <div class="nav-item" data-tab="supplies"><span class="num">04</span>Плановые поставки</div>
    <div class="nav-item" data-tab="employees"><span class="num">05</span>Сотрудники</div>
    <div class="sidebar-foot" id="sidebarFoot"></div>
  </div>

  <div class="main">
    <div class="topbar">
      <div class="eyebrow">Смена начата · 09:14</div>
      <div class="cabinets">
        <div class="chip wb"><span class="dot"></span>WB · кабинет подключён</div>
        <div class="chip oz"><span class="dot"></span>Ozon · кабинет подключён</div>
      </div>
    </div>

    <div class="content">

      <!-- INVENTORY -->
      <section class="section active" id="tab-inventory">
        <div class="page-head">
          <div>
            <h1>Остатки склада</h1>
            <p>Что и сколько лежит на полках прямо сейчас</p>
          </div>
          <div style="display:flex;gap:8px">
            <select class="search" id="invClientFilter" style="width:200px">
              <option value="">Все клиенты</option>
            </select>
            <input class="search" id="invSearch" placeholder="Поиск по названию или артикулу…">
          </div>
        </div>
        <div class="stat-row" id="invStats"></div>
        <div class="panel">
          <table>
            <thead><tr><th>Артикул</th><th>Товар</th><th>Клиент</th><th>Остаток</th><th></th></tr></thead>
            <tbody id="invBody"></tbody>
          </table>
        </div>
        <div id="writeoffLogWrap" style="margin-top:16px"></div>
      </section>

      <!-- CLIENTS -->
      <section class="section" id="tab-clients">
        <div class="page-head">
          <div>
            <h1>Клиенты</h1>
            <p>Продавцы, чей товар хранится на складе</p>
          </div>
          <button class="btn btn-accent" id="newClientBtn" onclick="openNewClientForm()">+ Новый клиент</button>
        </div>
        <div id="clientsBody"></div>
      </section>

      <!-- STORAGE -->
      <section class="section" id="tab-storage">
        <div class="page-head">
          <div>
            <h1>Хранение</h1>
            <p>Стоимость хранения по дням, в рублях</p>
          </div>
          <select class="search" id="storageClientFilter" style="width:220px">
            <option value="">Все клиенты</option>
          </select>
        </div>
        <div class="stat-row" id="storageStats"></div>
        <div class="panel" style="padding:22px" id="storageChartWrap"></div>
      </section>

      <!-- SUPPLIES (+ receiving inside) -->
      <section class="section" id="tab-supplies">
        <div class="page-head">
          <div>
            <h1>Плановые поставки</h1>
            <p>Плановые поступления от клиентов и приёмка товара на склад</p>
          </div>
          <div style="display:flex;gap:8px">
            <button class="btn btn-ghost" id="viewPlannedBtn" onclick="setSuppliesView('planned')">Плановые</button>
            <button class="btn btn-ghost" id="viewReceivingBtn" onclick="setSuppliesView('receiving')">Приёмка</button>
          </div>
        </div>
        <div id="suppliesBody">
          <div id="supplyCreatePanel"></div>
          <div class="panel" style="padding:12px 16px;margin-bottom:16px;display:flex;align-items:center;gap:10px">
            <input class="search" id="supplySearch" placeholder="Поиск по ID, клиенту, статусу…" style="flex:1">
            <span class="mono" id="supplyCount" style="font-size:12px;color:var(--ink-soft);white-space:nowrap"></span>
          </div>
          <div id="suppliesTableWrap"></div>
        </div>
        <div id="receivingBody"></div>
      </section>

      <!-- EMPLOYEES -->
      <section class="section" id="tab-employees">
        <div class="page-head">
          <div>
            <h1>Сотрудники</h1>
            <p>Доступ в личный кабинет и права по разделам</p>
          </div>
          <div style="display:flex;gap:8px">
            <button class="btn btn-ghost" id="viewEmployeesBtn" onclick="setEmployeesView('list')">Сотрудники</button>
            <button class="btn btn-ghost" id="viewRolesBtn" onclick="setEmployeesView('roles')">Роли и доступы</button>
            <button class="btn btn-accent" id="newEmployeeBtn" onclick="openNewEmployeeForm()">+ Новый сотрудник</button>
          </div>
        </div>
        <div id="employeesBody"></div>
      </section>

    </div>
  </div>
</div>

<div class="toast-wrap" id="toastWrap"></div>

<script>
// ---------- SUPABASE ----------
const SUPABASE_URL = 'https://mixsvqjlrifkcoeuuydc.supabase.co';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im1peHN2cWpscmlma2NvZXV1eWRjIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODc1MTYyNzEsImV4cCI6MjEwMzA5MjI3MX0.qIdelCgVkSDMc20f5X1parpfx2njHB5Pe3xk3ogbCr4';
let sb = null;
try{
  sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
}catch(e){
  console.error('Supabase init failed', e);
}

// ---------- STATE ----------
let inventory = []; // загружается из базы (loadInventory)

let clients = []; // загружается из базы (loadClients)
let clientCounter = 3;
let activeClientId = null;
let showingNewClientForm = false;

let receivingLog = []; // загружается из базы (loadReceivingLog)
let currentReceivingMode = 'scan';
let editingSku = null;
let writeOffSku = null;
let writeOffLog = []; // загружается из базы (loadWriteOffLog)
let historySku = null;
let movementLog = []; // загружается из базы (loadMovementLog)
let deletingSku = null;

let supplies = [];
let supplyCounter = 0;
let draftSupplyItems = [];
let draftSupplyClientId = '';
let draftSupplyFileName = '';
let currentSuppliesView = 'planned';
let activeSupplyId = null;

let roles = []; // загружается из базы (loadRoles)
let employees = []; // загружается из базы (loadEmployees)
let employeeCounter = 3;
let currentUser = null;
let currentEmployeesView = 'list';
let showingNewEmployeeForm = false;
let editingRoleId = null;

// ---------- HELPERS ----------
function toast(msg){
  const wrap = document.getElementById('toastWrap');
  const el = document.createElement('div');
  el.className = 'toast';
  el.textContent = msg;
  wrap.appendChild(el);
  setTimeout(()=>{ el.style.transition='opacity .3s'; el.style.opacity='0'; setTimeout(()=>el.remove(),300); }, 2600);
}

function switchTab(tab){
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.toggle('active', n.dataset.tab===tab));
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
