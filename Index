  let label, cls;
  if(s.status==='received'){ label='Принята'; cls='shipped'; }
  else if(totalReceived>0){ label='В работе'; cls='assembling'; }
  else { label='Едет'; cls='planned'; }
  return {totalQty, totalReceived, label, cls};
}
function renderSupplies(){
  renderSuppliesCreatePanel();
  renderSuppliesTableWrap();
}
function renderSuppliesCreatePanel(){
  const panel = document.getElementById('supplyCreatePanel');
  const canCreate = draftSupplyClientId && draftSupplyItems.length>0;
  const fileLabel = draftSupplyFileName
    ? `${draftSupplyFileName} — ${draftSupplyItems.length} SKU · ${draftSupplyItems.reduce((s,d)=>s+d.qty,0)} шт`
    : 'Файл не выбран';

  panel.innerHTML = `
    <div class="panel" style="padding:20px;margin-bottom:16px">
      <h3 style="font-size:18px;margin-bottom:4px">Создать плановую поставку</h3>
      <p style="font-size:13px;color:var(--ink-soft);margin:0 0 16px 0">Скачайте шаблон Excel (артикул, ШК, количество), выберите клиента и загрузите — поставка появится в приёмке со статусом «Едет».</p>

      <div class="eyebrow" style="margin-bottom:6px">Клиент склада / ИП</div>
      <select class="search" id="supplyClientSelect" style="width:100%;max-width:360px;margin-bottom:16px" onchange="setDraftSupplyClient(this.value)">
        <option value="">— выберите —</option>
        ${clients.map(c=>`<option value="${c.id}" ${draftSupplyClientId===c.id?'selected':''}>${c.name}</option>`).join('')}
      </select>

      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <button class="btn btn-ghost" onclick="downloadSupplyTemplate()">Скачать шаблон</button>
        <label class="btn btn-ghost" style="cursor:pointer;margin:0">
          Выбрать Excel
          <input type="file" accept=".xlsx,.xls" style="display:none" onchange="handleSupplyExcelUpload(this)">
        </label>
        <button class="btn ${canCreate?'btn-accent':'btn-ghost'}" ${canCreate?'':'disabled'} onclick="createSupply()">Создать поставку</button>
      </div>
      <div style="font-size:12px;color:var(--ink-faint);margin-top:10px">${fileLabel}</div>
    </div>
  `;
}
function renderSuppliesTableWrap(){
  const q = (document.getElementById('supplySearch').value || '').toLowerCase();
  const filtered = supplies.filter(s=>{
    if(!q) return true;
    const info = supplyStatusInfo(s);
    return s.id.toLowerCase().includes(q) || (s.clientName||'').toLowerCase().includes(q) || info.label.toLowerCase().includes(q);
  });
  document.getElementById('supplyCount').textContent = `${filtered.length} из ${supplies.length}`;

  const wrap = document.getElementById('suppliesTableWrap');
  if(!supplies.length){
    wrap.innerHTML = `<div class="panel empty"><span class="eyebrow">Пока нет поставок</span>Выберите клиента и загрузите Excel выше, чтобы создать первую</div>`;
    return;
  }
  if(!filtered.length){
    wrap.innerHTML = `<div class="panel empty">Ничего не найдено по запросу «${q}»</div>`;
    return;
  }

  wrap.innerHTML = `
    <div class="panel">
      <table>
        <thead><tr>
          <th>ID</th><th>Поставщик / ИП</th><th>Статус</th><th>Расхождения</th><th>Кол-во</th><th>SKU</th><th>Создана</th>
        </tr></thead>
        <tbody>
          ${filtered.map(s=>{
            const info = supplyStatusInfo(s);
            const isOpen = activeSupplyId===s.id;
            const hasDiscrepancy = s.status==='received' && info.totalReceived!==info.totalQty;
            const discHtml = hasDiscrepancy
              ? `<span class="status overdue">Есть расхождения</span>`
              : `<span style="color:var(--ink-faint);font-size:12px">—</span>`;
            const qtyHtml = hasDiscrepancy
              ? `<strong>${info.totalReceived} / ${info.totalQty}</strong>`
              : `${info.totalQty}`;
            let rowsHtml = `
              <tr style="cursor:${s.status!=='received'?'pointer':'default'};${hasDiscrepancy?'background:var(--warn-bg)':''}" onclick="toggleSupplyReceiving('${s.id}')">
                <td class="mono">${s.id}</td>
                <td>${s.clientName}</td>
                <td><span class="status ${info.cls}">${info.label}</span></td>
                <td>${discHtml}</td>
                <td>${qtyHtml}</td>
                <td>${s.items.length}</td>
                <td class="mono" style="font-size:12px">${formatSupplyDate(s.createdAt)}</td>
              </tr>
            `;
            if(isOpen && s.status!=='received'){
              rowsHtml += `<tr><td colspan="7" style="padding:0">${renderSupplyReceivingPanel(s)}</td></tr>`;
            }
            return rowsHtml;
          }).join('')}
        </tbody>
      </table>
    </div>
  `;

  if(activeSupplyId){
    const supply = supplies.find(s=>s.id===activeSupplyId);
    const input = document.getElementById('supplyScanInput-'+activeSupplyId);
    if(supply && input){
      input.focus();
      input.addEventListener('keydown', (e)=>{
        if(e.key!=='Enter') return;
        const code = input.value.trim().toUpperCase();
        input.value='';
        if(!code) return;
        const item = supply.items.find(i=>i.sku===code);
        if(!item){ toast('Этот артикул не входит в данную поставку'); return; }
        if(item.receivedQty >= item.qty){ toast('Эта позиция уже полностью принята'); return; }
        item.receivedQty++;
        const inv = inventory.find(i=>i.sku===code);
        if(inv) inv.qty++;
        logReceipt(code, item.name, 1);
        checkSupplyAutoComplete(supply);
        renderSuppliesTableWrap();
        sb.from('supply_items').update({received_qty: item.receivedQty}).eq('supply_id', supply.id).eq('sku', code).then(({error})=>{
          if(error) console.error(error);
        });
      });
    }
  }
}
document.getElementById('supplySearch').addEventListener('input', renderSuppliesTableWrap);

// ---------- AUTH & PERMISSIONS ----------
function renderLoginSelect(){
  const sel = document.getElementById('loginEmployeeSelect');
  sel.innerHTML = employees.filter(e=>e.active).map(e=>{
    const role = roles.find(r=>r.id===e.roleId);
    return `<option value="${e.id}">${e.name} — ${role?role.name:''}</option>`;
  }).join('');
}
function enterApp(emp){
  currentUser = emp;
  document.getElementById('loginScreen').style.display = 'none';
  document.getElementById('appRoot').style.display = 'flex';
  applyPermissions();
}
function attemptLogin(){
  const empId = document.getElementById('loginEmployeeSelect').value;
  const pin = document.getElementById('loginPin').value.trim();
  const emp = employees.find(e=>e.id===empId);
  if(!emp){ toast('Выберите сотрудника'); return; }
  if(pin !== emp.pin){ toast('Неверный PIN-код'); return; }
  try{ localStorage.setItem('sklad42_user_id', emp.id); }catch(e){}
  enterApp(emp);
}
function logout(){
  currentUser = null;
  try{ localStorage.removeItem('sklad42_user_id'); }catch(e){}
  document.getElementById('loginPin').value = '';
  document.getElementById('appRoot').style.display = 'none';
  document.getElementById('loginScreen').style.display = 'flex';
  renderLoginSelect();
}
function applyPermissions(){
  const role = roles.find(r=>r.id===currentUser.roleId);
  const perms = role ? role.permissions : {};
  let firstVisible = null;
  document.querySelectorAll('.nav-item[data-tab]').forEach(el=>{
    const allowed = perms[el.dataset.tab] !== false;
    el.style.display = allowed ? '' : 'none';
    if(allowed && !firstVisible) firstVisible = el.dataset.tab;
  });
  const groupLabel = document.querySelector('.nav-group-label');
  if(groupLabel) groupLabel.style.display = perms.inventory===false ? 'none' : '';
  document.getElementById('sidebarFoot').innerHTML = `
    <div class="sidebar-user">
      <div class="name">${currentUser.name}</div>
      <div class="role">${role?role.name:'—'}</div>
    </div>
    <button class="btn btn-ghost" style="width:100%;justify-content:center;padding:6px" onclick="logout()">Выйти</button>
  `;
  switchTab(firstVisible || 'inventory');
}

// ---------- EMPLOYEES & ROLES ----------
function setEmployeesView(view){ currentEmployeesView = view; renderEmployeesTab(); }
function openNewEmployeeForm(){ showingNewEmployeeForm = true; renderEmployeesTab(); }
function closeNewEmployeeForm(){ showingNewEmployeeForm = false; renderEmployeesTab(); }
function createEmployee(){
  const name = document.getElementById('newEmpName').value.trim();
  const login = document.getElementById('newEmpLogin').value.trim();
  const pin = document.getElementById('newEmpPin').value.trim() || '1234';
  const roleId = document.getElementById('newEmpRole').value;
  if(!name || !login){ toast('Укажите имя и логин'); return; }
  const id = 'EMP-' + Date.now();
  employees.push({id, name, login, pin, roleId, active:true});
  showingNewEmployeeForm = false;
  toast('Сотрудник добавлен');
  renderEmployeesTab();
  renderLoginSelect();
  sb.from('employees').insert({id, name, login, pin, role_id: roleId, active:true}).then(({error})=>{
    if(error){ console.error(error); toast('Не удалось сохранить сотрудника в базе (возможно, такой логин уже есть)'); }
  });
}
function toggleEmployeeActive(id){
  const emp = employees.find(e=>e.id===id);
  emp.active = !emp.active;
  renderEmployeesTab();
  renderLoginSelect();
  sb.from('employees').update({active: emp.active}).eq('id', id).then(({error})=>{
    if(error){ console.error(error); toast('Не удалось сохранить в базе'); }
  });
}
function togglePermission(roleId, key){
  const role = roles.find(r=>r.id===roleId);
  role.permissions[key] = !role.permissions[key];
  if(currentUser && currentUser.roleId===roleId) applyPermissions();
  renderEmployeesTab();
  sb.from('roles').update({permissions: role.permissions}).eq('id', roleId).then(({error})=>{
    if(error){ console.error(error); toast('Не удалось сохранить права в базе'); }
  });
}
function renderEmployeesTab(){
  document.getElementById('viewEmployeesBtn').className = 'btn ' + (currentEmployeesView==='list' ? 'btn-accent' : 'btn-ghost');
  document.getElementById('viewRolesBtn').className = 'btn ' + (currentEmployeesView==='roles' ? 'btn-accent' : 'btn-ghost');
  document.getElementById('newEmployeeBtn').style.display = currentEmployeesView==='list' ? 'inline-flex' : 'none';
  const body = document.getElementById('employeesBody');

  if(currentEmployeesView==='roles'){
    const permLabels = [['inventory','Остатки'],['clients','Клиенты'],['storage','Хранение'],['supplies','Плановые поставки'],['employees','Сотрудники']];
    body.innerHTML = roles.map(r=>`
      <div class="panel" style="padding:18px;margin-bottom:12px">
        <div class="oid" style="margin-bottom:10px">${r.name}</div>
        <div style="display:flex;gap:18px;flex-wrap:wrap">
          ${permLabels.map(([key,label])=>`
            <label style="display:flex;align-items:center;gap:6px;font-size:13px;cursor:pointer">
              <input type="checkbox" ${r.permissions[key]?'checked':''} onchange="togglePermission('${r.id}','${key}')">
              ${label}
            </label>
          `).join('')}
        </div>
      </div>
    `).join('');
    return;
  }

  const formHtml = showingNewEmployeeForm ? `
    <div class="panel" style="padding:18px;margin-bottom:18px">
      <div class="eyebrow" style="margin-bottom:10px">Новый сотрудник</div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px">
        <input class="search" id="newEmpName" placeholder="ФИО" style="flex:1;min-width:180px">
        <input class="search" id="newEmpLogin" placeholder="Логин" style="width:150px">
        <input class="search" id="newEmpPin" placeholder="PIN (по умолч. 1234)" style="width:170px">
        <select class="search" id="newEmpRole" style="width:200px">
          ${roles.map(r=>`<option value="${r.id}">${r.name}</option>`).join('')}
        </select>
      </div>
      <button class="btn btn-primary" onclick="createEmployee()">Создать</button>
      <button class="btn btn-ghost" onclick="closeNewEmployeeForm()">Отмена</button>
    </div>
  ` : '';

  const listHtml = `
    <div class="panel">
      <table>
        <thead><tr><th>Сотрудник</th><th>Логин</th><th>Роль</th><th>Статус</th><th></th></tr></thead>
        <tbody>
          ${employees.map(e=>{
            const role = roles.find(r=>r.id===e.roleId);
            return `<tr>
              <td>${e.name}${currentUser && currentUser.id===e.id ? ' <span style="color:var(--ink-faint);font-size:11px">(вы)</span>' : ''}</td>
              <td class="mono">${e.login}</td>
              <td>${role?role.name:'—'}</td>
              <td>${e.active ? '<span class="status assembled">Активен</span>' : '<span class="status shipped">Отключён</span>'}</td>
              <td style="text-align:right">
                <button class="btn btn-ghost" style="padding:5px 10px" onclick="toggleEmployeeActive('${e.id}')">${e.active?'Отключить':'Включить'}</button>
              </td>
            </tr>`;
          }).join('')}
        </tbody>
      </table>
    </div>
  `;

  body.innerHTML = formHtml + listHtml;
}

// ---------- LOAD FROM SUPABASE ----------
function formatLogTime(iso){
  const d = new Date(iso);
  return d.getHours().toString().padStart(2,'0')+':'+d.getMinutes().toString().padStart(2,'0');
}
async function loadRoles(){
  const { data, error } = await sb.from('roles').select('*').order('id');
  if(error){ console.error(error); return; }
  roles = data.map(r=>({id:r.id, name:r.name, permissions:r.permissions||{}}));
}
async function loadEmployees(){
  const { data, error } = await sb.from('employees').select('*').order('id');
  if(error){ console.error(error); return; }
  employees = data.map(e=>({id:e.id, name:e.name, login:e.login, pin:e.pin, roleId:e.role_id, active:e.active}));
}
async function loadInventory(){
  const { data, error } = await sb.from('inventory').select('*').order('sku');
  if(error){ console.error(error); return; }
  inventory = data.map(i=>({sku:i.sku, name:i.name, qty:i.qty, client:i.client_name, vendorCode:i.vendor_code, barcode:i.barcode, dims:i.dims}));
}
async function loadMovementLog(){
  const { data, error } = await sb.from('movement_log').select('*').order('created_at',{ascending:true}).limit(500);
  if(error){ console.error(error); return; }
  movementLog = data.map(m=>({sku:m.sku, name:m.name, delta:m.delta, type:m.type, time: formatLogTime(m.created_at)}));
}
async function loadWriteOffLog(){
  const { data, error } = await sb.from('write_off_log').select('*').order('created_at',{ascending:true}).limit(200);
  if(error){ console.error(error); return; }
  writeOffLog = data.map(w=>({sku:w.sku, name:w.name, qty:w.qty, reason:w.reason, time: formatLogTime(w.created_at)}));
}
async function loadReceivingLog(){
  const { data, error } = await sb.from('receiving_log').select('*').order('created_at',{ascending:true}).limit(200);
  if(error){ console.error(error); return; }
  receivingLog = data.map(r=>({sku:r.sku, name:r.name, qty:r.qty, time: formatLogTime(r.created_at)}));
}
async function loadClients(){
  const { data, error } = await sb.from('clients').select('*').order('name');
  if(error){ console.error(error); return; }
  clients = data.map(c=>({
    id:c.id, name:c.name, contact:c.contact||'—', wbKey:c.wb_key||'', wbConnected:c.wb_connected||false,
    wbProducts:[], storageLiters:c.storage_liters||0, pricePerLiter:c.price_per_liter||0
  }));
  clients.forEach(c => c.storageHistory = generateStorageHistory(c));
}
async function loadSupplies(){
  const { data: supplyRows, error: err1 } = await sb.from('supplies').select('*').order('created_at',{ascending:false});
  if(err1){ console.error(err1); return; }
  const { data: itemRows, error: err2 } = await sb.from('supply_items').select('*');
  if(err2){ console.error(err2); return; }
  supplies = supplyRows.map(s=>({
    id: s.id,
    clientId: s.client_id,
    clientName: s.client_name,
    status: s.status,
    createdAt: new Date(s.created_at),
    items: itemRows.filter(it=>it.supply_id===s.id).map(it=>({sku:it.sku, name:it.name, qty:it.qty, receivedQty:it.received_qty}))
  }));
}

// ---------- INIT ----------
async function initApp(){
  const sel = document.getElementById('loginEmployeeSelect');
  sel.innerHTML = `<option>Загрузка…</option>`;
  if(!sb){
    sel.innerHTML = `<option>Ошибка загрузки</option>`;
    toast('Не удалось загрузить библиотеку базы данных. Проверьте интернет и обновите страницу (F5)');
    return;
  }
  try{
    await Promise.all([loadRoles(), loadEmployees(), loadInventory(), loadMovementLog(), loadWriteOffLog(), loadReceivingLog(), loadClients(), loadSupplies()]);
  }catch(err){
    console.error(err);
  }
  if(!employees.length){
    toast('Не удалось подключиться к базе данных — проверьте, что SQL-схема выполнена');
  }
  renderLoginSelect();
  renderInventory();

  let savedUserId = null;
  try{ savedUserId = localStorage.getItem('sklad42_user_id'); }catch(e){}
  if(savedUserId){
    const emp = employees.find(e=>e.id===savedUserId && e.active);
    if(emp) enterApp(emp);
  }
}
initApp();
</script>
