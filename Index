function adjustQty(sku, delta){
  const item = inventory.find(i=>i.sku===sku);
  if(!item) return;
  const actualDelta = Math.max(0, item.qty + delta) - item.qty;
  item.qty = Math.max(0, item.qty + delta);
  if(actualDelta!==0) logMovement(sku, item.name, actualDelta, 'Ручная корректировка');
  renderInventory();
}
function startEdit(sku){ editingSku = sku; writeOffSku = null; deletingSku = null; historySku = null; renderInventory(); }
function cancelEdit(){ editingSku = null; renderInventory(); }
function saveEdit(sku){
  const item = inventory.find(i=>i.sku===sku);
  const name = document.getElementById('editName-'+sku).value.trim();
  const client = document.getElementById('editClient-'+sku).value.trim();
  const qty = Math.max(0, parseInt(document.getElementById('editQty-'+sku).value) || 0);
  if(!name){ toast('Название не может быть пустым'); return; }
  const qtyDelta = qty - item.qty;
  item.name = name;
  item.client = client || '—';
  item.qty = qty;
  if(qtyDelta!==0) logMovement(sku, name, qtyDelta, 'Изменение карточки');
  editingSku = null;
  toast('Изменения сохранены');
  renderInventory();
}
function openWriteOff(sku){ writeOffSku = sku; editingSku = null; deletingSku = null; historySku = null; renderInventory(); }
function cancelWriteOff(){ writeOffSku = null; renderInventory(); }
function confirmWriteOff(sku){
  const item = inventory.find(i=>i.sku===sku);
  const qty = Math.max(1, parseInt(document.getElementById('woQty-'+sku).value) || 1);
  const reason = document.getElementById('woReason-'+sku).value;
  if(qty > item.qty){ toast('Нельзя списать больше, чем есть на складе'); return; }
  item.qty -= qty;
  logWriteOff(item.sku, item.name, qty, reason);
  toast(`Списано: ${item.name} −${qty} шт (${reason})`);
  writeOffSku = null;
  renderInventory();
}
function logWriteOff(sku, name, qty, reason){
  const now = new Date();
  const time = now.getHours().toString().padStart(2,'0')+':'+now.getMinutes().toString().padStart(2,'0');
  writeOffLog.push({sku, name, qty, reason, time});
  sb.from('write_off_log').insert({sku, name, qty, reason}).then(({error})=>{ if(error) console.error(error); });
  logMovement(sku, name, -qty, 'Списание: '+reason);
}
function openDelete(sku){ deletingSku = sku; editingSku = null; writeOffSku = null; historySku = null; renderInventory(); }
function cancelDelete(){ deletingSku = null; renderInventory(); }
function confirmDelete(sku){
  const item = inventory.find(i=>i.sku===sku);
  inventory = inventory.filter(i=>i.sku!==sku);
  deletingSku = null;
  if(item){
    sb.from('movement_log').insert({sku, name:item.name, delta:-item.qty, type:'Удаление карточки'}).then(({error})=>{ if(error) console.error(error); });
  }
  sb.from('inventory').delete().eq('sku', sku).then(({error})=>{ if(error){ console.error(error); toast('Не удалось удалить в базе'); } });
  toast(`Карточка «${item ? item.name : sku}» удалена`);
  renderInventory();
}
function openHistory(sku){ historySku = historySku===sku ? null : sku; editingSku=null; writeOffSku=null; deletingSku=null; renderInventory(); }
function closeHistory(){ historySku = null; renderInventory(); }
function logMovement(sku, name, delta, type){
  const now = new Date();
  const time = now.getHours().toString().padStart(2,'0')+':'+now.getMinutes().toString().padStart(2,'0');
  movementLog.push({sku, name, delta, type, time});
  sb.from('movement_log').insert({sku, name, delta, type}).then(({error})=>{ if(error) console.error(error); });
  syncInventoryRow(sku);
}
async function syncInventoryRow(sku){
  const item = inventory.find(i=>i.sku===sku);
  if(!item) return;
  const { error } = await sb.from('inventory').upsert({
    sku: item.sku, name: item.name, qty: item.qty,
    client_name: item.client || null,
    vendor_code: item.vendorCode || null,
    barcode: item.barcode || null,
    dims: item.dims || null
  });
  if(error){ console.error(error); toast('Не удалось сохранить изменения в базе'); }
}
