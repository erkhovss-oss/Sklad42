function checkSupplyAutoComplete(supply){
  const total = supply.items.reduce((a,i)=>a+i.qty,0);
  const received = supply.items.reduce((a,i)=>a+i.receivedQty,0);
  if(received>=total && supply.status!=='received'){
    supply.status = 'received';
    sb.from('supplies').update({status:'received'}).eq('id', supply.id).then(({error})=>{ if(error) console.error(error); });
  }
}
function adjustSupplyItem(supplyId, sku, delta){
  const supply = supplies.find(s=>s.id===supplyId);
  const item = supply.items.find(i=>i.sku===sku);
  const newVal = Math.max(0, Math.min(item.qty, item.receivedQty + delta));
  const diff = newVal - item.receivedQty;
  if(diff===0) return;
  item.receivedQty = newVal;
  const inv = inventory.find(i=>i.sku===sku);
  if(inv) inv.qty += diff;
  if(diff>0) logReceipt(sku, item.name, diff);
  else logMovement(sku, item.name, diff, 'Корректировка приёмки поставки');
  checkSupplyAutoComplete(supply);
  renderSuppliesTableWrap();
  sb.from('supply_items').update({received_qty: item.receivedQty}).eq('supply_id', supplyId).eq('sku', sku).then(({error})=>{
    if(error) console.error(error);
  });
}
function finishSupplyReceiving(id){
  const supply = supplies.find(s=>s.id===id);
  const total = supply.items.reduce((a,i)=>a+i.qty,0);
  const received = supply.items.reduce((a,i)=>a+i.receivedQty,0);
  if(received < total){
    toast(`Приёмка приостановлена: принято ${received} из ${total} шт`);
  } else {
    supply.status = 'received';
    toast(`Поставка ${id} полностью принята`);
    sb.from('supplies').update({status:'received'}).eq('id', id).then(({error})=>{ if(error) console.error(error); });
  }
  activeSupplyId = null;
  renderSuppliesTableWrap();
}
